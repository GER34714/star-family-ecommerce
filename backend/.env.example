# ═══════════════════════════════════════════════════════════════════════════════
# VARIABLES DE ENTORNO - BACKEND STAR FAMILY E-COMMERCE
# ═══════════════════════════════════════════════════════════════════════════════
# Copia este archivo a .env y completa los valores reales
# ═══════════════════════════════════════════════════════════════════════════════

# Puerto del servidor (Render usa PORT automáticamente)
PORT=3000

# Entorno de ejecución
NODE_ENV=development

# ═══════════════════════════════════════════════════════════════════════════════
# MERCADO PAGO - CONFIGURACIÓN OBLIGATORIA
# ═══════════════════════════════════════════════════════════════════════════════

# Access Token de Mercado Pago (PROD)
# Obténlo desde: https://www.mercadopago.com/mla/account/credentials
MERCADOPAGO_ACCESS_TOKEN=APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ═══════════════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN OPCIONAL
# ═══════════════════════════════════════════════════════════════════════════════

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# Logging level
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════════════════════
# INSTRUCCIONES DEPLOY
# ═══════════════════════════════════════════════════════════════════════════════

# RENDER WEB SERVICE:
# 1. Crear Web Service (no Static Site)
# 2. Root Directory: backend
# 3. Build Command: npm install
# 4. Start Command: npm start
# 5. Environment Variables: configurar MERCADOPAGO_ACCESS_TOKEN
# 6. Auto-Deploy: yes

# VARIABLES DE ENTORNO EN RENDER:
# - PORT (automático)
# - NODE_ENV=production
# - MERCADOPAGO_ACCESS_TOKEN=tu_token_real

# ═══════════════════════════════════════════════════════════════════════════════
# ENDPOINTS DISPONIBLES
# ═══════════════════════════════════════════════════════════════════════════════

# GET /ping - Health check simple
# GET /health - Health check detallado
# POST /create-preference - Crear preferencia Mercado Pago
# GET /debug/env - Debug variables (solo desarrollo)
# POST /debug/request-test - Testing request/response

# ═══════════════════════════════════════════════════════════════════════════════
# EJEMPLOS DE USO
# ═══════════════════════════════════════════════════════════════════════════════

# CURL para crear preferencia:
# curl -X POST https://tu-backend.onrender.com/create-preference \
#   -H "Content-Type: application/json" \
#   -d '{
#     "items": [
#       {"name": "Producto Test", "price": 1000, "qty": 2}
#     ],
#     "origin": "https://tu-frontend.com",
#     "externalReference": "test_123"
#   }'

# ═══════════════════════════════════════════════════════════════════════════════
